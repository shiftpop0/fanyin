{
  "model": "Taizhou",
  "host": "0.0.0.0",
  "port": 8885,
  "server": "uvicorn",
  "dtype": "bf16",
  "device_map": "cuda:0",
  "max_inference_batch_size": 4,
  "max_new_tokens": 512,
  "diarize": true,
  "diarization_fallback": true,
  "max_chars": 40,
  "split_by_punctuation": true,
  "max_upload_mb": 512,
  "queue_timeout_sec": 600,
  "startup_check": true,
  "api_key_env": "TAILECT_API_KEY",
  "rate_limit_per_minute": 60
}
